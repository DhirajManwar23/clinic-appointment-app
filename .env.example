# Copy this file to .env before running the app:  cp .env.example .env

# Port the server listens on
PORT=3000

# Secret used to sign admin login tokens - CHANGE THIS to a long random string in production
JWT_SECRET=change_this_to_a_long_random_secret

# Default doctor/admin login (created automatically the first time the server starts)
ADMIN_USERNAME=doctor
ADMIN_PASSWORD=changeme123

# Clinic / doctor display info (shown in the admin dashboard)
DOCTOR_NAME=Dr. Sharma
CLINIC_NAME=OPD Sahayak Clinic

# Where the SQLite database file is stored (used only for local dev, when
# TURSO_DATABASE_URL below is left blank)
DB_PATH=./data/clinic.db

# ---- Production database (Turso) ----
# Leave both blank for local development — the app falls back to the local
# SQLite file above. For Vercel (or any serverless host), create a free
# database at https://turso.tech and fill these in — see README section 7.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
